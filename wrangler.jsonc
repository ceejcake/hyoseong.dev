{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyoseong-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Everything except the counter API is served straight from the static files.
    "run_worker_first": ["/icantplay3mod/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "icantplay3mod",
      "database_id": "PENDING"
    }
  ]
}
